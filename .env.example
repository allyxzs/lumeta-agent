# Modo de operação: "local", "ollama" ou "llm"
LUMETA_MODE=local

# --- Modo Ollama (LLM local sem dependências extras) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# --- Modo LLM (OpenAI ou API compatível) ---
OPENAI_API_KEY=sua_chave_aqui
LUMETA_MODEL=gpt-4o-mini
LUMETA_BASE_URL=

# --- Auditoria e Servidor ---
LUMETA_AUDIT_LOG=logs/audit.jsonl
LUMETA_API_HOST=127.0.0.1
LUMETA_API_PORT=8080
